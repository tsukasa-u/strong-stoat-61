{
  "name": "pua-font-obfuscator",
  "version": "0.1.1",
  "description": "Server-side HTML font obfuscation library.",
  "keywords": [
    "font-obfuscation",
    "html-obfuscation",
    "server-side",
    "ssr",
    "pua",
    "unicode",
    "webfont"
  ],
  "private": false,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsukasa-u/strong-stoat-61.git"
  },
  "bugs": {
    "url": "https://github.com/tsukasa-u/strong-stoat-61/issues"
  },
  "homepage": "https://github.com/tsukasa-u/strong-stoat-61#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.ja.md"
  ],
  "scripts": {
    "dev": "deno run --allow-net main.ts",
    "build": "tsup lib/index.ts --format esm --dts --clean",
    "prepack": "pnpm build",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "example:fetch": "pnpm build && tsx examples/fetch/main.ts",
    "example:fetch:jsx": "pnpm build && tsx examples/fetch/jsxExample.jsx",
    "example:fetch:tsx": "pnpm build && tsx examples/fetch/main.tsx",
    "example:hono": "pnpm build && tsx examples/hono/main.ts",
    "example:next": "pnpm build && tsx examples/next/main.ts",
    "example:remix": "pnpm build && tsx examples/remix/main.ts",
    "example:astro": "pnpm build && tsx examples/astro/main.ts",
    "example:sveltekit": "pnpm build && tsx examples/sveltekit/main.ts",
    "example:react": "pnpm build && tsx examples/react/main.tsx",
    "example:vue": "pnpm build && tsx examples/vue/main.ts",
    "verify:examples": "bash scripts/verify_examples.sh",
    "phase-c:build-assets": "tsx scripts/test-supp-pua.ts",
    "phase-c:serve-tmp": "cd /tmp && python3 -m http.server 8888",
    "phase-c:browser": "tsx scripts/test-supp-pua-browser.ts",
    "phase-c:fonttools": "/tmp/fonttools-venv/bin/python scripts/verify-supp-pua-fonttools.py",
    "phase-d:runtime:node": "node scripts/phase-d-runtime-compat.mjs",
    "phase-d:runtime:deno": "deno run scripts/phase-d-runtime-compat.mjs",
    "phase-d:benchmark": "pnpm exec tsx scripts/phase-d-benchmark.ts"
  },
  "dependencies": {
    "he": "^1.2.0",
    "opentype.js": "^2.0.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@types/he": "^1.2.3",
    "@types/node": "^22.19.20",
    "@vue/server-renderer": "^3.5.35",
    "hono": "^4.12.24",
    "playwright": "^1.60.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "solid-js": "^1.9.13",
    "tsup": "^8.5.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.6",
    "vue": "^3.5.35"
  },
  "pnpm": {
    "overrides": {
      "h3": ">=1.15.11",
      "postcss": ">=8.5.10",
      "astro": ">=6.1.6",
      "cookie": ">=0.7.0"
    }
  }
}
