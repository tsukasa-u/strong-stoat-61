---
const title = 'Astro Example';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
      button { padding: 0.45rem 0.8rem; margin: 0.24rem; border: 1px solid #d1d5db; border-radius: 0.45rem; background: #fff; color: #111827; font-size: 0.9rem; font-weight: 600; cursor: pointer; }
      button:hover { border-color: #9ca3af; }
      button:active { background: #f3f4f6; }
    </style>
  </head>
  <body style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;margin:0">
    <h1>Astro example</h1>
    <p>Client-side updates below are intentionally shown as plain text.</p>
    <p>Numeric counters are intentionally omitted because client-side arithmetic makes those relationships too obvious.</p>
    <p>Open <a href="/pre-encoded">/pre-encoded</a> to see the obfuscated server HTML example.</p>

    <h2>1) 通常文字列の難読化</h2>
    <p class="secret">このテキストは難読化されます。Hello World</p>

    <h2>2) 文字列状態</h2>
    <div>
      <button id="btn-status-working">Start</button>
      <button id="btn-status-done">Done</button>
      <button id="btn-status-reset">Reset</button>
    </div>
    <div>
      <button id="btn-tag-add">Add tag</button>
      <button id="btn-role-toggle">Toggle role</button>
    </div>
    <p id="status-current">status: idle</p>
    <p id="tags-current">tags: alpha, beta</p>
    <p id="profile-current">profile: Aki (editor)</p>

    <script>
      const tagOptions = ["gamma", "delta", "omega", "sigma"];
      let status = 'idle';
      let tags = ['alpha', 'beta'];
      let profile = { name: 'Aki', role: 'editor' };
      const statusEl = document.getElementById('status-current');
      const tagsEl = document.getElementById('tags-current');
      const profileEl = document.getElementById('profile-current');

      function render() {
        if (statusEl) statusEl.textContent = `status: ${status}`;
        if (tagsEl) tagsEl.textContent = `tags: ${tags.join(', ')}`;
        if (profileEl) profileEl.textContent = `profile: ${profile.name} (${profile.role})`;
      }

      document.getElementById('btn-status-working')?.addEventListener('click', () => {
        status = 'working';
        render();
      });
      document.getElementById('btn-status-done')?.addEventListener('click', () => {
        status = 'done';
        render();
      });
      document.getElementById('btn-status-reset')?.addEventListener('click', () => {
        status = 'idle';
        render();
      });
      document.getElementById('btn-tag-add')?.addEventListener('click', () => {
        const next = tagOptions.find((tag) => !tags.includes(tag));
        if (next) tags = [...tags, next];
        render();
      });
      document.getElementById('btn-role-toggle')?.addEventListener('click', () => {
        profile = { ...profile, role: profile.role === 'editor' ? 'admin' : 'editor' };
        render();
      });
    </script>
  </body>
</html>
