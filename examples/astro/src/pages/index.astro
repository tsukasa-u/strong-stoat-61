---
const title = 'Astro Example';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <style>
      button { padding: 0.45rem 0.8rem; margin: 0.24rem; border: 1px solid #d1d5db; border-radius: 0.45rem; background: #fff; color: #111827; font-size: 0.9rem; font-weight: 600; cursor: pointer; }
      button:hover { border-color: #9ca3af; }
      button:active { background: #f3f4f6; }
    </style>
  </head>
  <body style="min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;margin:0">
    <h1>Astro example</h1>
    <p>Client-side updates below are intentionally shown as plain text.</p>
    <p>Open <a href="/counter">/counter</a> and <a href="/pre-encoded">/pre-encoded</a> to see obfuscated server HTML examples.</p>

    <h2>1) 通常文字列の難読化</h2>
    <p class="secret">このテキストは難読化されます。Hello World</p>

    <h2>2) 数値カウント</h2>
    <div>
      <button id="btn-count">Count</button>
      <button id="btn-reset">Reset</button>
    </div>
    <p id="cnt">count: 0</p>

    <h2>3) 事前エンコード済み状態</h2>
    <div>
      <button id="btn-secure-next">Next Secure</button>
      <button id="btn-secure-reset">Reset Secure</button>
    </div>
    <p id="secure-state">secure-state: c3</p>

    <script>
      let c = 0;
      const secure = { encoded: ["a1", "b2", "c3", "d4"], indices: [2, 0, 3, 1], pos: 0 };
      const el = document.getElementById('cnt')!;
      const secureEl = document.getElementById('secure-state')!;
      document.getElementById('btn-count')!.addEventListener('click', () => { el.textContent = `count: ${++c}`; });
      document.getElementById('btn-reset')!.addEventListener('click', () => { c = 0; el.textContent = 'count: 0'; });
      document.getElementById('btn-secure-next')!.addEventListener('click', () => {
        secure.pos = Math.min(secure.pos + 1, secure.indices.length - 1);
        secureEl.textContent = `secure-state: ${secure.encoded[secure.indices[secure.pos]]}`;
      });
      document.getElementById('btn-secure-reset')!.addEventListener('click', () => {
        secure.pos = 0;
        secureEl.textContent = `secure-state: ${secure.encoded[secure.indices[secure.pos]]}`;
      });
    </script>
  </body>
</html>
